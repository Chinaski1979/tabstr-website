const SIZE_CLASSES: Record<FeatureSize, string> = {
  sm: "",
  lg: "sm:col-span-2",
  xl: "sm:col-span-2 lg:row-span-2",
};
---

<section class="relative w-full bg-bgDark2 py-20 sm:py-28" aria-labelledby={showHeader ? "features-heading" : undefined}>
  <div class="mx-auto w-11/12 max-w-6xl">
    {
      showHeader && (
        <div class="max-w-3xl mx-auto text-center mb-14" data-reveal>
          <span class="block-subtitle">Tecnología moderna, no fósiles digitales</span>
          <h2 id="features-heading" class="mt-5 mb-6 block-big-title lg:text-5xl">
            Funciones que <span class="text-gradient-brand">resuelven</span>, no que estorban.
          </h2>
          <p class="text-secondaryText leading-relaxed">
            Cada detalle de este POS existe por una razón: resolver los problemas reales que tienen los negocios
            todos los días.
          </p>
        </div>
      )
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 grid-flow-row-dense gap-4 lg:gap-5">
      {
        FEATURES.map((feature, index) => {
          const Tag = feature.href ? "a" : "div";
          return (
            <Tag
              href={feature.href}
              class:list={[
                "spotlight-card group flex flex-col p-6 sm:p-7",
                SIZE_CLASSES[feature.size],
                feature.size !== "sm" && "bg-gradient-to-br from-bgDark3/80 to-bgDark1/60",
              ]}
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 6) * 60}ms`}
            >
              <div class="relative z-10 flex items-start justify-between gap-4">
                <span class="icon-chip">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={ICON_PATHS[feature.icon]} />
                  </svg>
                </span>
                {feature.href && (
                  <span
                    class="text-secondaryText transition duration-300 group-hover:text-secondaryColor group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    →
                  </span>
                )}
              </div>

              <h3
                class:list={[
                  "relative z-10 mt-5 font-display font-bold tracking-tight text-primaryText",
                  feature.size === "xl" ? "text-2xl sm:text-3xl" : feature.size === "lg" ? "text-xl sm:text-2xl" : "text-lg",
                ]}
              >
                {feature.title}
              </h3>
              <p class="relative z-10 mt-2 text-secondaryText leading-relaxed text-sm sm:text-base">
                {feature.description}
              </p>

              {feature.visual === "invoice" && (
                <div class="relative z-10 mt-auto pt-8" aria-hidden="true">
                  <div class="rounded-2xl border border-solid border-white/10 bg-bgDark1/80 p-4 sm:p-5 text-xs sm:text-sm shadow-glow-sm">
                    <div class="flex items-center justify-between">
                      <span class="font-semibold text-primaryText">Factura electrónica</span>
                      <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[0.7rem] font-semibold text-emerald-400">
                        Aceptada
                      </span>
                    </div>
                    <p class="mt-1 font-mono text-[0.68rem] text-secondaryText/80 truncate">
                      Clave 50601112600310123456700100001010000000123
                    </p>
                    <div class="mt-4 space-y-2 border-t border-solid border-white/5 pt-3 text-secondaryText">
                      <div class="flex justify-between">
                        <span>2 × Casado de pollo</span>
                        <span>₡9.800</span>
                      </div>
                      <div class="flex justify-between">
                        <span>2 × Fresco natural</span>
                        <span>₡3.000</span>
                      </div>
                      <div class="flex justify-between">
                        <span>IVA 13%</span>
                        <span>₡1.664</span>
                      </div>
                    </div>
                    <div class="mt-3 flex items-center justify-between border-t border-solid border-white/5 pt-3">
                      <span class="text-secondaryText">Total</span>
                      <span class="font-display text-lg font-bold text-gradient-brand">₡14.464</span>
                    </div>
                    <div class="mt-3 flex items-center gap-2 text-[0.7rem] text-secondaryText">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                      Enviada a Hacienda · API v4.4
                    </div>
                  </div>
                </div>
              )}

              {feature.visual === "sinpe" && (
                <div class="relative z-10 mt-6 flex flex-wrap items-center gap-3" aria-hidden="true">
                  <div class="flex items-center gap-3 rounded-2xl border border-solid border-white/10 bg-bgDark1/80 px-4 py-3">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-sky-500/15 text-xs font-bold text-sky-300">
                      SM
                    </span>
                    <div class="text-xs sm:text-sm">
                      <p class="font-semibold text-primaryText">SINPE Móvil · ₡12.500</p>
                      <p class="text-secondaryText">Mesa 4 · 8:42 p. m.</p>
                    </div>
                  </div>
                  <span class="rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-semibold text-emerald-400">
                    ✓ Comprobante adjunto
                  </span>
                </div>
              )}

              {feature.visual === "offline" && (
                <div class="relative z-10 mt-6 flex flex-wrap items-center gap-2 text-xs sm:text-sm" aria-hidden="true">
                  <span class="flex items-center gap-2 rounded-full border border-solid border-secondaryColor/30 bg-secondaryColor/10 px-3 py-1 text-secondaryColor">
                    <span class="h-1.5 w-1.5 rounded-full bg-secondaryColor"></span>
                    Sin conexión
                  </span>
                  <span class="text-secondaryText">→</span>
                  <span class="rounded-full border border-solid border-white/10 bg-bgDark1/80 px-3 py-1 text-secondaryText">
                    3 ventas en cola
                  </span>
                  <span class="text-secondaryText">→</span>
                  <span class="flex items-center gap-2 rounded-full border border-solid border-emerald-400/30 bg-emerald-500/10 px-3 py-1 text-emerald-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                    Sincronizado
                  </span>
                </div>
              )}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>
