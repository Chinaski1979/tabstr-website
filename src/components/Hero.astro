---
import dashboard from "../assets/images/tabs-management.webp";
import { whatsappUrl } from "../lib/whatsapp";

const demoUrl = whatsappUrl("Hola, me gustaría agendar una demo de Tabstr POS para mi negocio.");

const trustItems: string[] = [
  "Sin licencia por dispositivo",
  "Hacienda 4.4",
  "Funciona sin internet",
];
---

<section id="home" class="relative overflow-hidden bg-bgDark1 pt-32 sm:pt-40 pb-12 sm:pb-20">
  <div class="absolute inset-0 bg-grid-fade" aria-hidden="true"></div>
  <div
    class="brand-glow animate-glow-pulse w-[36rem] h-[28rem] sm:w-[60rem] sm:h-[34rem] left-1/2 -ml-[18rem] sm:-ml-[30rem] -top-56"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto w-11/12 max-w-5xl flex flex-col items-center text-center">
    <a
      href="/reservas-restaurantes/"
      class="motion-safe:animate-fade-up group inline-flex items-center gap-2 rounded-full border border-solid border-secondaryColor/30 bg-white/[0.04] backdrop-blur px-4 py-1.5 text-xs sm:text-sm text-secondaryText hover:border-secondaryColor/60 hover:text-primaryText transition"
    >
      <span class="rounded-full bg-brand-gradient px-2 py-0.5 text-[0.7rem] font-bold uppercase tracking-wider text-primaryText">
        Nuevo
      </span>
      Gestión de reservas
      <span class="transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>

    <p
      class="motion-safe:animate-fade-up mt-8 text-secondaryColor text-sm sm:text-base font-bold"
      style="animation-delay: 60ms"
    >
      Tabstr POS para restaurantes y comercios en Costa Rica
    </p>

    <h1
      class="motion-safe:animate-fade-up mt-4 font-display text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-7xl font-bold tracking-tight text-primaryText"
      style="animation-delay: 120ms"
    >
      <span class="md:hidden">Funciona en <span class="text-gradient-brand">cualquier dispositivo</span></span>
      <span class="hidden md:inline">
        El punto de venta que funciona en <span class="text-gradient-brand">cualquier dispositivo</span>
      </span>
    </h1>

    <p
      class="motion-safe:animate-fade-up mt-8 max-w-2xl text-secondaryText text-base lg:text-lg leading-relaxed"
      style="animation-delay: 180ms"
    >
      Tabstr POS es un sistema de punto de venta (POS) para restaurantes y comercios en Costa Rica. Corre en celular, tablet o computadora, no cobra licencia por dispositivo e incluye facturación electrónica Hacienda 4.4.
    </p>

    <div
      class="motion-safe:animate-fade-up mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center w-full sm:w-auto"
      style="animation-delay: 240ms"
    >
      <a href="/contacto/" class="contained-button h-12 px-7 w-full sm:w-auto">
        Probar 1 mes gratis
      </a>
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ghost-button h-12 px-7 w-full sm:w-auto"
      >
        <svg class="w-4 h-4 text-[#25d366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.464 3.488 11.815 11.815 0 0012.05 0zm0 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884z"></path>
        </svg>
        Agendar demo por WhatsApp
      </a>
    </div>

    <ul
      class="motion-safe:animate-fade-up mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-secondaryText"
      style="animation-delay: 300ms"
    >
      {
        trustItems.map((item) => (
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondaryColor" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M16.704 5.29a1 1 0 01.006 1.414l-7.5 7.57a1 1 0 01-1.42 0l-3.5-3.53a1 1 0 111.42-1.408l2.79 2.814 6.79-6.854a1 1 0 011.414-.006z"
                clip-rule="evenodd"
              />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="relative z-10 mx-auto mt-16 sm:mt-20 w-11/12 lg:w-4/5 2xl:w-[1200px]">
    <div class="hero-tilt">
      <div class="glow-border relative rounded-2xl bg-white/[0.04] p-1.5 sm:p-2 shadow-glow-lg">
        <img
          src={dashboard.src}
          alt="POS Tabstr en tablet en restaurante Costa Rica, con mesas y cuentas abiertas"
          width={dashboard.width}
          height={dashboard.height}
          fetchpriority="high"
          class="w-full h-auto rounded-xl"
        />
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-bgDark1"
    aria-hidden="true"
  >
  </div>
</section>
