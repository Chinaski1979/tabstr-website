---
import Layout from '../../layouts/Layout.astro'
import { Navbar } from '../../components/Navbar.jsx'
import { Footer } from '../../components/Footer.jsx'
import { ScrollUpButton } from '../../components/ScrollUpButton'
import '../../styles/Theme.css'
import { blogData } from '../../data/blogData'
---

<Layout
  title="Blog Tabstr POS Costa Rica | Migración y punto de venta"
  description="Historias y guías de Tabstr POS: por qué nació el sistema, cómo migrar de un POS viejo y cómo dejar de pagar licencia por dispositivo en Costa Rica."
  canonicalPath="/blog/"
>
  <Navbar client:load />
  
  <main class="w-screen flex justify-center bg-bgDark2 pt-24 pb-16">
    <div class="container px-4 max-w-7xl">
      <div class="text-center mb-16">
        <span class="block-subtitle">Blog</span>
        <h1 class="mt-6 mb-6 text-4xl lg:text-5xl font-bold font-heading text-primaryText">
          Últimas publicaciones
        </h1>
        <p class="text-lg text-secondaryText max-w-2xl mx-auto">
          Ideas directas sobre POS, migración y operación de tu negocio.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {blogData.map((post) => (
          <a
            href={post.href}
            class="w-full group"
          >
            <article class="p-6 sm:p-10 bg-bgDark3 rounded-3xl hover:bg-bgDark3Hover transition cursor-pointer h-full flex flex-col">
              <img
                src={post.image}
                alt={post.title}
                class="rounded-3xl mb-6 w-full h-48 sm:h-56 object-cover"
              />
              <time class="text-sm text-secondaryColor mb-3 block">{post.date}</time>
              <h2 class="mb-4 text-xl sm:text-2xl font-bold font-heading text-primaryText group-hover:text-secondaryColor transition">
                {post.title}
              </h2>
              <p class="text-secondaryText leading-relaxed line-clamp-3">
                {post.subtitle}
              </p>
            </article>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
  <ScrollUpButton client:load />
</Layout>
