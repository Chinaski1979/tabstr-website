---
import Layout from '../../layouts/Layout.astro'
import { Navbar } from '../../components/Navbar.tsx'
import { Footer } from '../../components/Footer.jsx'
import { ScrollUpButton } from '../../components/ScrollUpButton'
import BlogCard from '../../components/BlogCard.astro'
import '../../styles/Theme.css'
import { blogData } from '../../data/blogData'
---

<Layout
  title="Blog Tabstr POS Costa Rica | Migración y punto de venta"
  description="Historias y guías de Tabstr POS: por qué nació el sistema, cómo migrar de un POS viejo y cómo dejar de pagar licencia por dispositivo en Costa Rica."
  canonicalPath="/blog/"
>
  <Navbar client:load />
  
  <div class="relative overflow-hidden w-full bg-bgDark2 pt-32 pb-16">
    <div class="brand-glow w-[40rem] h-[24rem] left-1/2 -ml-[20rem] -top-48 opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto w-11/12 max-w-6xl">
      <div class="text-center mb-16">
        <span class="block-subtitle">Blog</span>
        <h1 class="mt-6 mb-6 block-big-title lg:text-6xl">
          Últimas publicaciones
        </h1>
        <p class="text-lg text-secondaryText max-w-2xl mx-auto">
          Ideas directas sobre POS, migración y operación de tu negocio.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        {blogData.map((post, index) => (
          <BlogCard post={post} headingLevel="h2" revealDelay={index * 100} />
        ))}
      </div>
    </div>
  </div>

  <Footer />
  <ScrollUpButton client:load />
</Layout>
