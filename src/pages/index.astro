---
import Layout from "../layouts/Layout.astro";
import { Hero } from "../components/Hero.jsx";
import { Navbar } from "../components/Navbar.jsx";
import { Clients } from "../components/Clients.jsx";
import { Features1 } from "../components/Features1.jsx";
import { Features2 } from "../components/Features2.jsx";
import { FeaturesDiagonal } from "../components/FeaturesDiagonal.jsx";
import { Blog } from "../components/Blog";
import { Contact } from "../components/Contact.jsx";
import { Footer } from "../components/Footer.jsx";
import { ScrollUpButton } from "../components/ScrollUpButton";
import FaqSection from "../components/FaqSection.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import AudienceFit from "../components/AudienceFit.astro";
import RelatedPages from "../components/RelatedPages.astro";
import {
  ENTITY_SENTENCE,
  HOME_DESCRIPTION,
  HOME_TITLE,
  faqPageSchema,
  organizationSchema,
  softwareSchema,
} from "../data/seo";
import { FAQ_ITEMS } from "../data/faq";
import "../styles/Theme.css";
import "../styles/Diagonals.css";
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  canonicalPath="/"
  jsonLd={[
    organizationSchema(),
    softwareSchema(),
    faqPageSchema(FAQ_ITEMS),
  ]}
>
  <Navbar client:load />
  <Hero client:load />
  <Clients client:load />
  <Features1 client:load />
  <Features2 client:load />
  <FeaturesDiagonal client:load />
  <section class="w-full bg-bgDark2 py-8">
    <div class="container mx-auto px-4 w-11/12 md:w-10/12 xl:w-4/5 2xl:w-2/3 max-w-5xl">
      <p class="text-secondaryText leading-relaxed text-lg mb-8">{ENTITY_SENTENCE}</p>
      <ComparisonTable />
      <AudienceFit />
      <RelatedPages />
    </div>
  </section>
  <Blog client:load />
  <FaqSection />
  <Contact client:load />
  <Footer />
  <ScrollUpButton client:load />
</Layout>
